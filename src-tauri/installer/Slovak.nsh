LangString addOrReinstall ${LANG_SLOVAK} "Pridať/preinštalovať súčasti"
LangString alreadyInstalled ${LANG_SLOVAK} "Už nainštalované"
LangString alreadyInstalledLong ${LANG_SLOVAK} "${PRODUCTNAME} ${VERSION} je už nainštalovaný. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString appRunning ${LANG_SLOVAK} "{{product_name}} je spustený! Najprv ho zatvorte a skúste to znova."
LangString appRunningOkKill ${LANG_SLOVAK} "{{product_name}} je spustený!$\nKliknutím na OK ho ukončíte"
LangString chooseMaintenanceOption ${LANG_SLOVAK} "Vyberte údržbovú operáciu, ktorú chcete vykonať."
LangString chooseHowToInstall ${LANG_SLOVAK} "Vyberte, ako chcete nainštalovať ${PRODUCTNAME}."
LangString createDesktop ${LANG_SLOVAK} "Vytvoriť odkaz na pracovnej ploche"
LangString dontUninstall ${LANG_SLOVAK} "Neodinštalovať"
LangString dontUninstallDowngrade ${LANG_SLOVAK} "Neodinštalovať (prechod na staršiu verziu bez odinštalovania tento inštalátor nepovoľuje)"
LangString failedToKillApp ${LANG_SLOVAK} "{{product_name}} sa nepodarilo ukončiť. Najprv ho zatvorte a skúste to znova"
LangString installingWebview2 ${LANG_SLOVAK} "Inštaluje sa WebView2..."
LangString newerVersionInstalled ${LANG_SLOVAK} "Novšia verzia ${PRODUCTNAME} je už nainštalovaná! Inštalácia staršej verzie sa neodporúča. Ak ju naozaj chcete nainštalovať, najprv odinštalujte aktuálnu verziu. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString older ${LANG_SLOVAK} "staršia"
LangString olderOrUnknownVersionInstalled ${LANG_SLOVAK} "Vo vašom systéme je nainštalovaná $R4 verzia ${PRODUCTNAME}. Pred inštaláciou sa odporúča aktuálnu verziu odinštalovať. Vyberte operáciu, ktorú chcete vykonať, a pokračujte kliknutím na Ďalej."
LangString silentDowngrades ${LANG_SLOVAK} "Prechod na staršiu verziu je v tomto inštalátore zakázaný, tichá inštalácia nemôže pokračovať. Použite grafický inštalátor.$\n"
LangString unableToUninstall ${LANG_SLOVAK} "Odinštalovanie zlyhalo!"
LangString uninstallApp ${LANG_SLOVAK} "Odinštalovať ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SLOVAK} "Pred inštaláciou odinštalovať"
LangString unknown ${LANG_SLOVAK} "neznáma"
LangString webview2AbortError ${LANG_SLOVAK} "Inštalácia WebView2 zlyhala! Aplikácia bez neho nemôže bežať. Skúste inštalátor spustiť znova."
LangString webview2DownloadError ${LANG_SLOVAK} "Chyba: sťahovanie WebView2 zlyhalo - $0"
LangString webview2DownloadSuccess ${LANG_SLOVAK} "Inštalátor WebView2 bol úspešne stiahnutý"
LangString webview2Downloading ${LANG_SLOVAK} "Sťahuje sa inštalátor WebView2..."
LangString webview2InstallError ${LANG_SLOVAK} "Chyba: inštalácia WebView2 zlyhala s kódom $1"
LangString webview2InstallSuccess ${LANG_SLOVAK} "WebView2 bol úspešne nainštalovaný"
LangString deleteAppData ${LANG_SLOVAK} "Odstrániť údaje aplikácie"
