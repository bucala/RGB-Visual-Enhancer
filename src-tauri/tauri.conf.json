{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RGB Visual Enhancer",
  "version": "0.2.0",
  "identifier": "io.github.bucala.rgbvisualenhancer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RGB Visual Enhancer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#090b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Jednotné ovládanie RGB osvetlenia",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-rgb-visual-enhancer.rules": "../packaging/linux/60-rgb-visual-enhancer.rules"
        }
      }
    },
    "longDescription": "Lightweight cross-vendor RGB lighting control for ASUS Aura, Logitech G, MSI GPUs and BLE LED strips, with system tray integration.",
    "publisher": "RGB Visual Enhancer",
    "copyright": "© 2026 RGB Visual Enhancer contributors, MIT License",
    "windows": {
      "wix": {
        "language": [
          "sk-SK",
          "en-US"
        ]
      },
      "nsis": {
        "languages": [
          "Slovak",
          "English"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Slovak": "installer/Slovak.nsh"
        },
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
